{
  "name": "@perrylink/dsh-plugin-kit",
  "version": "0.1.21",
  "description": "Shared zero-runtime-dependency toolkit for PerryLink DSH plugins: a pluggable Provider registry seam, fail-closed approval and adaptive session-event gates, mechanical verify scripts, shared sanitize/pricing/judge modules, and a new-plugin skeleton.",
  "author": "PerryLink",
  "license": "Apache-2.0",
  "homepage": "https://www.npmjs.com/package/@perrylink/dsh-plugin-kit",
  "repository": {
    "type": "git",
    "url": "https://github.com/PerryLink/dsh-plugin-kit"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./seam": {
      "types": "./lib/seam/provider.d.ts",
      "default": "./lib/seam/provider.js"
    },
    "./gates": {
      "types": "./lib/gates/index.d.ts",
      "default": "./lib/gates/index.js"
    },
    "./shared": {
      "types": "./lib/shared/index.d.ts",
      "default": "./lib/shared/index.js"
    },
    "./verify": {
      "types": "./lib/verify/index.d.ts",
      "default": "./lib/verify/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "template",
    "cordis.patch.yml",
    "README.md",
    "README-zh.md",
    "README-es.md",
    "README-pt.md",
    "README-hi.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "STANDARDS.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "standards": {
      "schema": "dsh-levels/1",
      "entry": {
        "status": "not-run",
        "evidence": null
      },
      "flow": {
        "status": "not-run",
        "evidence": null
      },
      "boost": {
        "status": "not-measured",
        "evidence": null
      }
    }
  },
  "scripts": {
    "check:readmes": "node scripts/check-readme-sync.mjs",
    "build": "node scripts/prepare.mjs",
    "prepare": "node scripts/prepare.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:ci": "tsc -p tsconfig.ci.json --noEmit",
    "typecheck:checkout": "tsc -p tsconfig.checkout.json --noEmit",
    "test": "vitest run",
    "verify:self-contained": "node scripts/verify-self-contained.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "perrylink",
    "provider",
    "seam",
    "approval",
    "sanitize",
    "pricing",
    "judge"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "packageManager": "pnpm@11.7.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-session": ">=0.1.2-rc.1 <0.2.0 || >=0.1.5-alpha.1 <0.2.0 || >=0.1.6-0 <0.2.0 || >=0.1.7-0 <0.2.0 || >=0.2.0-0 <0.3.0 || >=0.2.1-0 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1 <0.2.0 || >=0.1.5-alpha.1 <0.2.0 || >=0.1.6-0 <0.2.0 || >=0.1.7-0 <0.2.0 || >=0.2.0-0 <0.3.0 || >=0.2.1-0 <0.3.0",
    "@deepseek-ai/dsh-user-approval": ">=0.1.2-rc.1 <0.2.0 || >=0.1.5-alpha.1 <0.2.0 || >=0.1.6-0 <0.2.0 || >=0.1.7-0 <0.2.0 || >=0.2.0-0 <0.3.0 || >=0.2.1-0 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1",
    "@types/node": "^22.19.0",
    "vitest": "^4.1.10",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "typescript": "^6.0.3"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/PerryLink"
  }
}
